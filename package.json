{
  "name": "mist-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx src/installer/cli.ts",
    "eval:resident-self-repair": "tsx src/eval/resident-self-repair/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "acceptance": "tsx acceptance/run.ts",
    "acceptance:strict": "tsx acceptance/run.ts --strict",
    "acceptance:isolation": "tsx acceptance/isolation-run.ts",
    "acceptance:isolation:strict": "tsx acceptance/isolation-run.ts --strict",
    "acceptance:external-channel": "test -x ./node_modules/.bin/tsx && tsx acceptance/external-channel-run.ts",
    "acceptance:telegram-channel": "tsx acceptance/telegram-channel-run.ts",
    "acceptance:telegram-channel:strict": "tsx acceptance/telegram-channel-run.ts --strict",
    "acceptance:host-provider": "tsx acceptance/host-provider-run.ts",
    "acceptance:host-provider:strict": "tsx acceptance/host-provider-run.ts --strict",
    "acceptance:resident-continuity": "tsx acceptance/resident-continuity-run.ts",
    "acceptance:resident-continuity:strict": "tsx acceptance/resident-continuity-run.ts --strict",
    "acceptance:window-history": "tsx acceptance/window-history-run.ts",
    "acceptance:window-history:strict": "tsx acceptance/window-history-run.ts --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@inquirer/prompts": "^8.5.2",
    "ajv": "^8.20.0"
  }
}
