{
  "name": "@deepseek-ai/dsh-root",
  "version": "0.1.0-rc.5",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/landlock-run",
    "native/landlock-run/packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:skin && npm run build:lib && npm run build:web",
    "build:lib": "npm run build:lib:host && npm run build:lib:client",
    "build:lib:host": "tsc -b tsconfig.host.json && tsdown --env.DSH_BUILD_FACE host",
    "build:lib:client": "tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "build:skin": "node packages/client/web/scripts/build-skin.mjs",
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build",
    "dev:web": "npm run build:skin && pnpm --filter @deepseek-ai/dsh-web-frontend run dev",
    "typecheck": "tsc -b tsconfig.client.json",
    "test": "vitest run",
    "test:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build && vitest run -c vitest.web.config.ts",
    "clean": "git clean -fdX apps packages vendor native",
    "lint": "tsx scripts/run-oxlint.ts ."
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@yarnpkg/cli-dist": "4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "fast-check": "^4.8.0",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.2.0",
    "jscpd": "^5.0.12",
    "jsdom": "29.1.1",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "^0.3.21",
    "smol-toml": "^1.7.1",
    "spdx-expression-parse": "^5.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}